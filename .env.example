# Copia este archivo a .env (que git ignora) o define estas variables en el hosting.
# NUNCA subas claves reales al repositorio.

# Clave de Google AI Studio
GEMINI_API_KEY=

# Modelos en orden de preferencia, separados por comas (el segundo es respaldo)
GEMINI_MODELS=gemini-3.5-flash-lite

# Clave que la plataforma enviará como "Authorization: Bearer <API_KEY>".
# Si se deja vacía, el endpoint queda sin autenticación.
API_KEY=

# Límites
MAX_MESSAGES=20
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=700
RATE_LIMIT_PER_MIN=30
UPSTREAM_TIMEOUT=20
